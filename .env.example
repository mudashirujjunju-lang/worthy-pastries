# Copy to .env (or set in Render/Railway dashboard)
PORT=3000
# REQUIRED in production - admin dashboard password (default "changeme" is insecure)
ADMIN_PASSWORD=change-this-to-a-long-password
# Optional: secret for signing admin sessions (defaults to a hash of ADMIN_PASSWORD)
SESSION_SECRET=
# Where the SQLite DB and uploaded photos live. On Render use a persistent disk, e.g. /var/data
DATA_DIR=./data
# Max order/custom-request submissions per IP per 15 min
ORDER_RATE_LIMIT=10
